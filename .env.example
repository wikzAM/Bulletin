# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=            # platform key; set a spend limit on it in the Console
DATABASE_URL=postgres://bulletin:bulletin@localhost:5432/bulletin
API_PORT=4000
API_URL=http://localhost:4000
BULLETIN_TOKEN_SECRET=        # signs short-lived, mission-scoped station tokens
BULLETIN_SCRATCH_DIR=.bulletin-scratch   # all worktrees live here and are cleaned up
AUTH_SECRET=                  # Auth.js (M3)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
