{
  "name": "bulletin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --ignore-pattern \".claude/**\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify": "pnpm install --frozen-lockfile --prefer-offline && pnpm lint && pnpm typecheck && pnpm test",
    "build": "turbo run build",
    "dev:api": "pnpm --filter @bulletin/api dev",
    "dev:web": "pnpm --filter @bulletin/web dev",
    "db:generate": "pnpm --filter @bulletin/db generate",
    "bulletin": "tsx apps/api/src/cli.ts",
    "sidecar:prepare": "node scripts/prepare-sidecar.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
